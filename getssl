#!/usr/bin/env python3
import argparse
import os
import sys

from certapi.domain_matching import domain_matches_cert_domain
from nginx import Nginx
from nginx_proxy.certificate_backend import build_certificate_backend
from nginx_proxy.certapi_config import load_certapi_config


def parse_args():
    parser = argparse.ArgumentParser(
        description="Obtain Let's Encrypt SSL certificate for one or more domains.",
        epilog="This script respects environment variables: CERTAPI_URL, SSL_DIR, CHALLENGE_DIR, etc.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Skip certapi/nginx-proxy self-verification before requesting the certificate. ACME validation still runs.",
    )
    parser.add_argument("domains", nargs="+", help="Domain(s) to include in the certificate.")
    return parser.parse_args()


def main():
    args = parse_args()
    try:
        ssl_dir = os.getenv("SSL_DIR", "/etc/ssl").strip().rstrip("/")
        conf_dir = os.getenv("NGINX_CONF_DIR", "/etc/nginx").strip().rstrip("/")
        challenge_dir = os.getenv("CHALLENGE_DIR", "/etc/nginx/challenges").strip().rstrip("/") + "/"
        renew_threshold_days = int(os.getenv("CERT_RENEW_THRESHOLD_DAYS", "30").strip())
        certapi = load_certapi_config()
        nginx = Nginx.Nginx(
            os.path.join(conf_dir, "conf.d/gen-ssl-direct.conf"),
            challenge_dir=challenge_dir,
            create_challenge_dir=certapi is None,
        )
        backend_info = build_certificate_backend(
            ssl_dir, nginx, config={"certapi": certapi}, renew_threshold_days=max(10, renew_threshold_days)
        )
        result = backend_info.backend.obtain(
            args.domains,
            key_type="ecdsa",
            batch_domains=backend_info.batch_domains,
            self_verify=not args.force,
            skip_failing=False,
            renew_threshold_days=max(10, renew_threshold_days),
        )
        for label, certificates in (("New Certificates", result.issued), ("Reuse Existing", result.existing)):
            if certificates:
                print(f"[ {label} ] : " + ", ".join(sorted({d for cert in certificates for d in cert.domains})))
        covered = [domain for cert in result.issued + result.existing for domain in cert.domains]
        missing = [d for d in args.domains if not any(domain_matches_cert_domain(c, d) for c in covered)]
        failures = getattr(result, "failed", [])
        for failure in failures:
            print(f"[ Failed ] {', '.join(failure.domains)}: {failure.message}", file=sys.stderr)
        # Apply certificates that were saved even if an older server returned partial success.
        if covered:
            print("Reloading nginx...")
            if not nginx.reload():
                print(
                    "Error: Failed to reload nginx; certificates have been saved but are not applied.", file=sys.stderr
                )
                return 1
        if missing or failures:
            print("Error: Could not obtain certificates for: " + ", ".join(missing), file=sys.stderr)
            return 1
        return 0
    except Exception as error:
        print(f"Error obtaining certificate: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
